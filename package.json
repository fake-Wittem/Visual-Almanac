{
  "name": "visual-almanac",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run images && vite --host 127.0.0.1",
    "validate": "tsx scripts/validate-content.ts",
    "images": "tsx scripts/generate-images.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate && npm run images && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "poster:prompt": "tsx scripts/poster-prompt.ts",
    "poster:render": "tsx scripts/render-posters.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.42.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.11"
  }
}
