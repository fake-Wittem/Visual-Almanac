  "notes": [
    {
      "title": "图像与语义",
      "body": "用比例突变、切断与错接制造新关系，碎片应形成提问，而不是只有怀旧质感。"
    },
    {
      "title": "文字与材料",
      "body": "字母可以成为图形，新闻纸与机械图像可相互干扰；保留剪边和叠层，让媒介痕迹可见。"
    },
    {
      "title": "历史与应用边界",
      "body": "达达涉及表演、现成物与反艺术立场；海报只提炼拼贴路径，不把运动简化成一套装饰模板。"
    }
  ],
  "applications": [
    "文化专题海报可用一处突兀尺度或图文错置制造停顿，同时为标题、时间与正文保留可识别的层级。"
  ],
  "related": ["surrealism", "punk-diy", "swiss-international"],
