  "updatedAt": "2026-09-10",
  "designHistory": {
    "overview": "达达在第一次世界大战时期及其后，于苏黎世、柏林、纽约等城市发展。各地实践并不统一，现成物、拼贴、表演与偶然性共同挑战艺术惯例；其后又与超现实主义形成联系与分歧。",
    "timeline": [
      {
        "year": 1916,
        "period": "1916 年起",
        "title": "多地展开反常规实验",
        "body": "MoMA 将达达在苏黎世、柏林、汉诺威、科隆、纽约和巴黎的活跃发展置于 1916—1924 年间，提示它并非单一城市的一种画法。",
        "sourceIds": ["dada"]
      },
      {
        "year": 1919,
        "period": "1919—1920 年",
        "title": "机械、文字与拼贴交错",
        "body": "皮卡比亚、施维特斯和恩斯特等人的作品把机械意象、日常碎片与非惯常组合带入画面，扩展图像与物件的关系。",
        "sourceIds": ["works"]
      },
      {
        "year": 1924,
        "period": "1924 年前后",
        "title": "运动分化与新方向",
        "body": "达达的活跃阶段走向分化；1924 年的超现实主义宣言和刊物构成另一个思想节点，不能把两者视为完全相同的运动。",
        "sourceIds": ["dada", "library"]
      }
    ],
    "interpretation": "原创拼贴借用剪贴、尺度冲突与碎字方法，不是历史作品或报刊的复制；本档案也不声称数字生成等同达达的偶然创作过程。",
