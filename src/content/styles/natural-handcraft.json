  "designHistory": {
    "overview": "自然手作不是统一的历史流派。本档案以英国工艺美术与工作室陶艺的一条线索说明当代手作审美的来源，不将其代表全部地区的工艺传统。",
    "timeline": [
      {
        "year": 1887,
        "period": "19 世纪后期",
        "title": "重新重视制作与材料",
        "body": "工艺美术运动关注设计和制作的联系，1887 年成立的展览协会为工艺提供持续的公开展示空间。",
        "sourceIds": ["crafts"]
      },
      {
        "year": 1920,
        "period": "1920 年",
        "title": "工作室与跨文化交流",
        "body": "Leach 与滨田庄司在圣艾夫斯建立陶坊，将个人制作、器用和东亚陶艺经验带入英国工作室陶艺。",
        "sourceIds": ["pottery"]
      },
      {
        "year": 1960,
        "period": "1960 年代",
        "title": "手作扩展为多样艺术语言",
        "body": "工作室陶艺形成国际社群，从日常餐具延伸到雕塑性器形；手工并不意味着固定的乡村样式。",
        "sourceIds": ["pottery"]
      }
    ],
    "interpretation": "图中陶器和纤维只是材料关系的原创演绎，未冒充任何传统窑口作品；四种颜色由本档案设定。",
