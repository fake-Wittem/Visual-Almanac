  "designHistory": {
    "overview": "哥特式在十二世纪法国的建筑探索中形成，并传播到欧洲不同地区及雕塑、彩窗、器物等媒介。它兼有结构创新、宗教叙事和自然观察，不能概括成黑暗气氛。",
    "timeline": [
      {
        "year": 1140,
        "period": "1140—1144 年",
        "title": "光照与高度的新空间",
        "body": "圣但尼教堂东部改建把既有建筑技术重新组合，使更高、更明亮的礼仪空间成为重要范例。",
        "sourceIds": ["gothic-va"]
      },
      {
        "year": 1170,
        "period": "1170 年代起",
        "title": "外部支撑与大窗",
        "body": "飞扶壁帮助承接拱顶侧推力，墙面得以容纳更大的窗；建筑语言随后在各地发展出不同版本。",
        "sourceIds": ["gothic-met"]
      },
      {
        "year": 1250,
        "period": "十三至十四世纪",
        "title": "从教堂向多种媒介扩展",
        "body": "随着城市、贸易和赞助群体发展，哥特形式进入器物与图像；艺术家也更细致地处理自然叶形和人物情感。",
        "sourceIds": ["gothic-va"]
      }
    ],
    "interpretation": "海报以虚构场景提炼哥特式的材料、构图与视觉关系；不复制馆藏原件，不作为历史现场或实际工程的证明。",
